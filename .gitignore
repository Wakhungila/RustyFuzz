# ─────────────────────────────────────────────────────────────
# Rust build output
# ─────────────────────────────────────────────────────────────
/target/

# Keep Cargo.toml committed.
# For this project, keep Cargo.lock committed too because RustyFuzz is a binary/tool.
# Do not ignore Cargo.toml or Cargo.lock.

# Local Cargo config only if you use machine-specific settings.
/.cargo/

# ─────────────────────────────────────────────────────────────
# RustyFuzz runtime artifacts
# ─────────────────────────────────────────────────────────────
/.rustyfuzz/
/corpus/
/saved-runs/
/reports/*
!/reports/satori_baseline.md
/seeds/
/crashes/
/findings/
/artifacts/
/fork-cache/
/fork_cache/
/seed-bundles/
/seed_bundles/
/replays/
/minimized/
/coverage/
/.runs/
formal_spec.toml
PoolFactory.json

# Satori / AI runtime output. Keep docs, config examples, prompts, and
# placeholder files trackable.
/satori/cache/*
!/satori/cache/.gitkeep
/satori/jobs/*
!/satori/jobs/.gitkeep
/satori/memory/*
!/satori/memory/.gitkeep
/satori/packets/*
!/satori/packets/.gitkeep
/satori/reports/*
!/satori/reports/.gitkeep
/satori/runs/*
!/satori/runs/.gitkeep

# Local benchmark and fuzz output. Deterministic benchmark manifests and
# fixtures under benchmarks/** remain trackable.
/benchmarks/results/
/benchmarks/tmp/
/benchmarks/generated/

# Temporary Foundry or PoC-generation projects.
/out/
/broadcast/
/foundry-cache/
/foundry-tmp/
/tmp-foundry/
/foundry-projects/

# Runtime campaign databases / generated state
*.cache
*.db
*.sqlite
*.sqlite3
*.profraw
*.profdata
*.trace

# ─────────────────────────────────────────────────────────────
# Config / secrets
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.*
*.env.*
config.toml
config.local.toml
*.rpc

# Keep a sanitized config.example.toml committed.

# ─────────────────────────────────────────────────────────────
# Logs and temp files
# ─────────────────────────────────────────────────────────────
*.log
*.tmp
*.swp
*.swo
*.bak

# ─────────────────────────────────────────────────────────────
# Compiled and build artifacts
# ─────────────────────────────────────────────────────────────
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe

# ─────────────────────────────────────────────────────────────
# Node / vendored deps
# ─────────────────────────────────────────────────────────────
node_modules/

# Only ignore vendor/ if you are not intentionally vendoring dependencies.
/vendor/

# ─────────────────────────────────────────────────────────────
# Editors
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/

# ─────────────────────────────────────────────────────────────
# Coverage
# ─────────────────────────────────────────────────────────────
htmlcov/
.coverage

# ─────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
