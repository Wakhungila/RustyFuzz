chain = "evm"
rpc_url = "https://archive-rpc.example.invalid"   # replace with an archive RPC via environment/config management
fork_block = 22000000  
target_contract = "0x0000000000000000000000000000000000001337"   # Contract Address
fuzzer_address = "0x0000000000000000000000000000000000000000"    # replace with a campaign caller
max_depth = 5
initial_seeds = 50
timeout_secs = 60
corpus_dir = "corpus"
report_dir = "reports"
mainnet_seed_bundle = "target-mainnet"
target_abi = "abi/Target.json"
abi_cache_dir = "corpus/abi"
llm_enabled = false

[hardened_defi]
enabled = false
single_process = true
deterministic = true
rng_seed = 42
historical_seed_file = "seeds/example_historical_seed.json"
max_template_sequences = 128
enable_actor_model = true
enable_economic_delta = true
enable_protocol_invariants = true
enable_exploit_templates = true
min_persist_confidence = 0.70

[hardened_defi.checkpoint]
directory = ".rustyfuzz/checkpoints/example"
every_execs = 1000
resume = false
